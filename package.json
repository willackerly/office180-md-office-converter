{
  "name": "office180-md-office-converter",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "pnpm --filter @office180/pptv build",
    "browser:build": "pnpm --filter @office180/pptv browser:build",
    "browser:check": "pnpm --filter @office180/pptv browser:check",
    "browser-calibration:check": "pnpm --filter @office180/pptv browser-calibration:check",
    "browser-calibration:update": "pnpm --filter @office180/pptv browser-calibration:update",
    "editor:build": "pnpm --filter @office180/pptv editor:build",
    "editor:check": "pnpm --filter @office180/pptv editor:check",
    "pack:check": "pnpm --filter @office180/pptv pack:check",
    "format": "prettier --write \"packages/pptv/src/**/*.ts\" \"packages/pptv/e2e/**/*.ts\" \"packages/pptv/scripts/*.mjs\" \"scripts/*.mjs\" \"packages/pptv/*.ts\" \"packages/pptv/*.json\" \"packages/pptv/test-fixtures/**/*.json\" package.json pnpm-workspace.yaml tsconfig.base.json \"schemas/*.json\"",
    "format:check": "prettier --check \"packages/pptv/src/**/*.ts\" \"packages/pptv/e2e/**/*.ts\" \"packages/pptv/scripts/*.mjs\" \"scripts/*.mjs\" \"packages/pptv/*.ts\" \"packages/pptv/*.json\" \"packages/pptv/test-fixtures/**/*.json\" package.json pnpm-workspace.yaml tsconfig.base.json \"schemas/*.json\"",
    "typecheck": "pnpm --filter @office180/pptv typecheck",
    "test": "pnpm test:ts && pnpm test:python",
    "test:browser": "pnpm browser:check && pnpm --filter @office180/pptv test:browser",
    "test:browser:all": "pnpm browser:check && pnpm --filter @office180/pptv test:browser:all",
    "test:ts": "pnpm --filter @office180/pptv test",
    "test:python": ".venv/bin/python tests/test_roundtrip.py && .venv/bin/python tests/test_visual_evidence.py && .venv/bin/python tests/test_native_office_bridge.py",
    "pptv": "tsx packages/pptv/src/bin.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^26.1.2",
    "esbuild": "0.28.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
