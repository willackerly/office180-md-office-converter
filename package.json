{
  "name": "office180-md-office-converter",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "pnpm --filter @office180/pptv build",
    "pack:check": "pnpm --filter @office180/pptv pack:check",
    "format": "prettier --write \"packages/pptv/src/**/*.ts\" \"packages/pptv/scripts/*.mjs\" \"packages/pptv/*.ts\" \"packages/pptv/*.json\" package.json pnpm-workspace.yaml tsconfig.base.json \"schemas/*.json\"",
    "format:check": "prettier --check \"packages/pptv/src/**/*.ts\" \"packages/pptv/scripts/*.mjs\" \"packages/pptv/*.ts\" \"packages/pptv/*.json\" package.json pnpm-workspace.yaml tsconfig.base.json \"schemas/*.json\"",
    "typecheck": "pnpm --filter @office180/pptv typecheck",
    "test": "pnpm test:ts && pnpm test:python",
    "test:ts": "pnpm --filter @office180/pptv test",
    "test:python": ".venv/bin/python tests/test_roundtrip.py",
    "pptv": "tsx packages/pptv/src/bin.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
