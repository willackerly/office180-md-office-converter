{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office180.dev/schemas/native-office-bridge-0.1.schema.json",
  "title": "office180 native Office bridge report 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "phase",
    "input",
    "application",
    "environment",
    "lifecycle",
    "commands",
    "output",
    "cleanup",
    "publication",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "office180-native-office-bridge/0.1"
    },
    "status": {
      "enum": ["passed", "failed", "unavailable"]
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "application": {
      "$ref": "#/$defs/application"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "commands": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/command"
          },
          {
            "$ref": "#/$defs/poll"
          }
        ]
      }
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))"
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "media_kind", "copy_verified"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_kind": {
          "enum": ["docx", "pptx"]
        },
        "copy_verified": {
          "type": "boolean"
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bundle_id",
        "short_version",
        "build_version",
        "renderer_class"
      ],
      "properties": {
        "name": {
          "enum": ["Microsoft Word", "Microsoft PowerPoint"]
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "short_version": {
          "type": "string",
          "minLength": 1
        },
        "build_version": {
          "type": "string",
          "minLength": 1
        },
        "renderer_class": {
          "enum": ["native-word", "native-powerpoint"]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_system", "version", "architecture"],
      "properties": {
        "operating_system": {
          "const": "macOS"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "timeout_seconds",
        "evidence_scope",
        "representative_editability",
        "visual_fidelity",
        "handoff_attempts",
        "handoff_accepted",
        "exact_path_attachment",
        "read_only",
        "forced_dirty_save",
        "save_event_returned_saved",
        "post_save_saved",
        "save_quiescent",
        "closed_after_save",
        "zip_valid",
        "reopen_saved",
        "reopen_passed",
        "open_without_repair"
      ],
      "properties": {
        "method": {
          "const": "non-interactive-nsworkspace+applescript"
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 10,
          "maximum": 300
        },
        "evidence_scope": {
          "const": "native-no-op-save-lifecycle"
        },
        "representative_editability": {
          "const": "not-tested"
        },
        "visual_fidelity": {
          "const": "not-tested"
        },
        "handoff_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "handoff_accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "exact_path_attachment": {
          "type": "boolean"
        },
        "read_only": {
          "type": ["boolean", "null"]
        },
        "forced_dirty_save": {
          "type": "boolean"
        },
        "save_event_returned_saved": {
          "type": "boolean"
        },
        "post_save_saved": {
          "type": "boolean"
        },
        "save_quiescent": {
          "type": "boolean"
        },
        "closed_after_save": {
          "type": "boolean"
        },
        "zip_valid": {
          "type": "boolean"
        },
        "reopen_saved": {
          "type": "boolean"
        },
        "reopen_passed": {
          "type": "boolean"
        },
        "open_without_repair": {
          "type": "boolean"
        },
        "save_size": {
          "type": "integer",
          "minimum": 1
        },
        "save_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "quiescence_observations": {
          "type": "integer",
          "minimum": 1
        },
        "quiescence_polls": {
          "type": "integer",
          "minimum": 1
        },
        "bytes_changed": {
          "type": "boolean"
        },
        "part_count": {
          "type": "integer",
          "minimum": 1
        },
        "uncompressed_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "reopen_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "commandCore": {
      "type": "object",
      "required": [
        "argv",
        "timeout_seconds",
        "duration_ms",
        "exit_code",
        "timed_out",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "timed_out": {
          "type": "boolean"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "script_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "command": {
      "allOf": [
        {
          "$ref": "#/$defs/commandCore"
        },
        {
          "type": "object",
          "required": ["phase", "operation"],
          "properties": {
            "phase": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "poll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "operation",
        "expected_count",
        "attempt_count",
        "observed_counts",
        "timed_out_attempts",
        "sampled_commands",
        "omitted_attempts",
        "outcome"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "const": "exact-path-poll"
        },
        "expected_count": {
          "enum": [0, 1]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "propertyNames": {
            "pattern": "^-?[0-9]+$"
          }
        },
        "timed_out_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "sampled_commands": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/commandCore"
              }
            ],
            "unevaluatedProperties": false
          }
        },
        "omitted_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "enum": ["matched", "duplicate", "invalid-response", "deadline"]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "published"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "published": {
          "type": "boolean"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_kind": {
          "enum": ["docx", "pptx"]
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_absence_proven", "work_directory_disposition"],
      "properties": {
        "exact_absence_proven": {
          "type": "boolean"
        },
        "work_directory": {
          "$ref": "#/$defs/relativePath"
        },
        "work_directory_disposition": {
          "enum": [
            "not-created",
            "active",
            "remove-before-pair-commit",
            "removed",
            "preserved-handoff-not-released",
            "preserved-cleanup-failed",
            "preserved-by-request"
          ]
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_marker", "pair_committed", "residual_limit"],
      "properties": {
        "commit_marker": {
          "const": "report"
        },
        "pair_committed": {
          "type": "boolean"
        },
        "residual_limit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "phase", "message", "retryable", "next_actions"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^OFFICE-NATIVE-[A-Z-]+$"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "phase": {
            "const": "complete"
          },
          "output": {
            "required": ["sha256", "bytes", "media_kind"],
            "properties": {
              "published": {
                "const": true
              }
            }
          },
          "publication": {
            "properties": {
              "pair_committed": {
                "const": true
              }
            }
          },
          "diagnostics": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "properties": {
              "published": {
                "const": false
              }
            }
          },
          "publication": {
            "properties": {
              "pair_committed": {
                "const": false
              }
            }
          },
          "diagnostics": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
