{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office180.dev/schemas/pptv-manifest-0.1.schema.json",
  "title": "PPTV Manifest 0.1",
  "type": "object",
  "required": ["pptv", "slides"],
  "properties": {
    "pptv": { "const": "0.1" },
    "title": { "type": "string" },
    "runtime": { "$ref": "#/$defs/profileId" },
    "editor": { "$ref": "#/$defs/profileId" },
    "theme": { "$ref": "#/$defs/stableId" },
    "themes": {
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/stableId" },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/$defs/stableId" },
              "layout": { "$ref": "#/$defs/stableId" },
              "hidden": { "type": "boolean" },
              "namespace": { "$ref": "#/$defs/stableId" },
              "src": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "agentProfile": { "$ref": "#/$defs/profileId" },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "profileId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*/[0-9]+(?:\\.[0-9]+)*$"
    }
  },
  "additionalProperties": false
}
