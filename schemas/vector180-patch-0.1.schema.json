{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office180.dev/schemas/vector180-patch-0.1.schema.json",
  "title": "Vector180 Patch 0.1",
  "type": "object",
  "required": ["schema", "baseSha256", "ops"],
  "properties": {
    "schema": { "const": "vector180-patch/0.1" },
    "baseSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transactionId": { "type": "string" },
    "author": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/setText" },
          { "$ref": "#/$defs/setActiveTheme" },
          { "$ref": "#/$defs/setSlideOrder" },
          { "$ref": "#/$defs/setRectGeometry" },
          { "$ref": "#/$defs/setEllipseGeometry" },
          { "$ref": "#/$defs/setConnectorEndpoints" },
          { "$ref": "#/$defs/setGroupTranslation" },
          { "$ref": "#/$defs/setTextFrame" },
          { "$ref": "#/$defs/setChildOrder" },
          { "$ref": "#/$defs/deleteObject" },
          { "$ref": "#/$defs/setNativeStyle" },
          { "$ref": "#/$defs/cloneConnector" }
        ]
      },
      "contains": { "$ref": "#/$defs/cloneConnector" },
      "minContains": 0,
      "maxContains": 1
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "finiteNumber": { "type": "number" },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/finiteNumber" },
        "y": { "$ref": "#/$defs/finiteNumber" }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "$ref": "#/$defs/finiteNumber" },
        "y": { "$ref": "#/$defs/finiteNumber" },
        "width": { "$ref": "#/$defs/positiveNumber" },
        "height": { "$ref": "#/$defs/positiveNumber" }
      },
      "additionalProperties": false
    },
    "rectGeometry": {
      "type": "object",
      "required": ["kind", "x", "y", "width", "height"],
      "properties": {
        "kind": { "const": "rect" },
        "x": { "$ref": "#/$defs/finiteNumber" },
        "y": { "$ref": "#/$defs/finiteNumber" },
        "width": { "$ref": "#/$defs/positiveNumber" },
        "height": { "$ref": "#/$defs/positiveNumber" }
      },
      "additionalProperties": false
    },
    "ellipseGeometry": {
      "type": "object",
      "required": ["kind", "cx", "cy", "rx", "ry"],
      "properties": {
        "kind": { "const": "ellipse" },
        "cx": { "$ref": "#/$defs/finiteNumber" },
        "cy": { "$ref": "#/$defs/finiteNumber" },
        "rx": { "$ref": "#/$defs/positiveNumber" },
        "ry": { "$ref": "#/$defs/positiveNumber" }
      },
      "additionalProperties": false
    },
    "connectorEndpoints": {
      "type": "object",
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": { "$ref": "#/$defs/finiteNumber" },
        "y1": { "$ref": "#/$defs/finiteNumber" },
        "x2": { "$ref": "#/$defs/finiteNumber" },
        "y2": { "$ref": "#/$defs/finiteNumber" }
      },
      "additionalProperties": false
    },
    "concreteStyle": {
      "type": "object",
      "required": [
        "fill",
        "stroke",
        "strokeWidth",
        "opacity",
        "fontWeight",
        "fontStyle",
        "textAnchor"
      ],
      "properties": {
        "fill": {
          "type": "string",
          "pattern": "^(?:none|#[0-9a-f]{6})$"
        },
        "stroke": {
          "type": "string",
          "pattern": "^(?:none|#[0-9a-f]{6})$"
        },
        "strokeWidth": { "type": "number", "minimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "fontFamily": { "type": "string", "minLength": 1 },
        "fontSize": { "$ref": "#/$defs/positiveNumber" },
        "fontWeight": { "enum": [400, 700] },
        "fontStyle": { "enum": ["normal", "italic"] },
        "textAnchor": { "enum": ["start", "middle", "end"] }
      },
      "additionalProperties": false
    },
    "connectorCloneState": {
      "type": "object",
      "required": ["fromId", "toId", "endpoints", "style"],
      "properties": {
        "fromId": { "$ref": "#/$defs/stableId" },
        "toId": { "$ref": "#/$defs/stableId" },
        "endpoints": { "$ref": "#/$defs/connectorEndpoints" },
        "style": { "$ref": "#/$defs/concreteStyle" }
      },
      "additionalProperties": false
    },
    "stableIdArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    },
    "setText": {
      "type": "object",
      "required": ["op", "id", "oldText", "value"],
      "properties": {
        "op": { "const": "set-text" },
        "id": { "$ref": "#/$defs/stableId" },
        "oldText": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": false
    },
    "setActiveTheme": {
      "type": "object",
      "required": ["op", "oldTheme", "theme"],
      "properties": {
        "op": { "const": "set-active-theme" },
        "theme": { "$ref": "#/$defs/stableId" },
        "oldTheme": { "$ref": "#/$defs/stableId" }
      },
      "additionalProperties": false
    },
    "setSlideOrder": {
      "type": "object",
      "required": ["op", "oldOrder", "order"],
      "properties": {
        "op": { "const": "set-slide-order" },
        "order": {
          "allOf": [{ "$ref": "#/$defs/stableIdArray" }, { "minItems": 1 }]
        },
        "oldOrder": { "$ref": "#/$defs/stableIdArray" }
      },
      "additionalProperties": false
    },
    "setRectGeometry": {
      "type": "object",
      "required": ["op", "id", "oldGeometry", "geometry"],
      "properties": {
        "op": { "const": "set-object-geometry" },
        "id": { "$ref": "#/$defs/stableId" },
        "oldGeometry": { "$ref": "#/$defs/rectGeometry" },
        "geometry": { "$ref": "#/$defs/rectGeometry" }
      },
      "additionalProperties": false
    },
    "setEllipseGeometry": {
      "type": "object",
      "required": ["op", "id", "oldGeometry", "geometry"],
      "properties": {
        "op": { "const": "set-object-geometry" },
        "id": { "$ref": "#/$defs/stableId" },
        "oldGeometry": { "$ref": "#/$defs/ellipseGeometry" },
        "geometry": { "$ref": "#/$defs/ellipseGeometry" }
      },
      "additionalProperties": false
    },
    "setConnectorEndpoints": {
      "type": "object",
      "required": ["op", "id", "oldEndpoints", "endpoints"],
      "properties": {
        "op": { "const": "set-connector-endpoints" },
        "id": { "$ref": "#/$defs/stableId" },
        "oldEndpoints": { "$ref": "#/$defs/connectorEndpoints" },
        "endpoints": { "$ref": "#/$defs/connectorEndpoints" }
      },
      "additionalProperties": false
    },
    "setGroupTranslation": {
      "type": "object",
      "required": ["op", "id", "oldTranslation", "translation"],
      "properties": {
        "op": { "const": "set-group-translation" },
        "id": { "$ref": "#/$defs/stableId" },
        "oldTranslation": { "$ref": "#/$defs/point" },
        "translation": { "$ref": "#/$defs/point" }
      },
      "additionalProperties": false
    },
    "setTextFrame": {
      "type": "object",
      "required": [
        "op",
        "id",
        "oldFrame",
        "frame",
        "oldLineAnchor",
        "lineAnchor"
      ],
      "properties": {
        "op": { "const": "set-text-frame" },
        "id": { "$ref": "#/$defs/stableId" },
        "oldFrame": { "$ref": "#/$defs/bounds" },
        "frame": { "$ref": "#/$defs/bounds" },
        "oldLineAnchor": { "$ref": "#/$defs/point" },
        "lineAnchor": { "$ref": "#/$defs/point" }
      },
      "additionalProperties": false
    },
    "setChildOrder": {
      "type": "object",
      "required": ["op", "parentId", "oldOrder", "order"],
      "properties": {
        "op": { "const": "set-child-order" },
        "parentId": { "$ref": "#/$defs/stableId" },
        "oldOrder": { "$ref": "#/$defs/stableIdArray" },
        "order": { "$ref": "#/$defs/stableIdArray" }
      },
      "additionalProperties": false
    },
    "deleteObject": {
      "type": "object",
      "required": ["op", "id", "oldParentId", "oldOrder"],
      "properties": {
        "op": { "const": "delete-object" },
        "id": { "$ref": "#/$defs/stableId" },
        "oldParentId": {
          "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        },
        "oldOrder": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "setNativeStyle": {
      "type": "object",
      "required": ["op", "id", "oldStyle", "style"],
      "properties": {
        "op": { "const": "set-native-style" },
        "id": { "$ref": "#/$defs/stableId" },
        "oldStyle": { "$ref": "#/$defs/concreteStyle" },
        "style": { "$ref": "#/$defs/concreteStyle" }
      },
      "additionalProperties": false
    },
    "cloneConnector": {
      "type": "object",
      "required": [
        "op",
        "templateId",
        "newId",
        "parentId",
        "oldOrder",
        "order",
        "oldConnector",
        "connector"
      ],
      "properties": {
        "op": { "const": "clone-connector" },
        "templateId": { "$ref": "#/$defs/stableId" },
        "newId": { "$ref": "#/$defs/stableId" },
        "parentId": { "$ref": "#/$defs/stableId" },
        "oldOrder": { "$ref": "#/$defs/stableIdArray" },
        "order": { "$ref": "#/$defs/stableIdArray" },
        "oldConnector": { "$ref": "#/$defs/connectorCloneState" },
        "connector": { "$ref": "#/$defs/connectorCloneState" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
