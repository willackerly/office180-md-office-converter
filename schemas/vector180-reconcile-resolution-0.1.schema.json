{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office180.dev/schemas/vector180-reconcile-resolution-0.1.schema.json",
  "title": "Vector180 Reviewed Connector-Copy Resolution 0.1",
  "description": "Exact unresolved-report-, finding-, hash-, classification-, and fingerprint-bound review input for one duplicated mapped native connector.",
  "type": "object",
  "required": [
    "schema",
    "reconciliationReportSha256",
    "findingId",
    "classification",
    "sourceSha256",
    "baselineMapSha256",
    "editedPptxSha256",
    "comparisonPptxSha256",
    "duplicateId",
    "newId",
    "baselineOccurrenceFingerprintSha256",
    "copiedOccurrenceFingerprintSha256",
    "parentId",
    "oldOrder",
    "order",
    "connector"
  ],
  "properties": {
    "schema": { "const": "vector180-reconcile-resolution/0.1" },
    "reconciliationReportSha256": { "$ref": "#/$defs/sha256" },
    "findingId": { "$ref": "#/$defs/findingId" },
    "classification": { "const": "one-baseline-equivalent-copy" },
    "sourceSha256": { "$ref": "#/$defs/sha256" },
    "baselineMapSha256": { "$ref": "#/$defs/sha256" },
    "editedPptxSha256": { "$ref": "#/$defs/sha256" },
    "comparisonPptxSha256": { "$ref": "#/$defs/sha256" },
    "duplicateId": { "$ref": "#/$defs/stableId" },
    "newId": { "$ref": "#/$defs/stableId" },
    "baselineOccurrenceFingerprintSha256": { "$ref": "#/$defs/sha256" },
    "copiedOccurrenceFingerprintSha256": { "$ref": "#/$defs/sha256" },
    "parentId": { "$ref": "#/$defs/stableId" },
    "oldOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "order": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "connector": { "$ref": "#/$defs/connector" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^finding\\.[a-f0-9]{16}$"
    },
    "finiteNumber": {
      "type": "number"
    },
    "endpoints": {
      "type": "object",
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": { "$ref": "#/$defs/finiteNumber" },
        "y1": { "$ref": "#/$defs/finiteNumber" },
        "x2": { "$ref": "#/$defs/finiteNumber" },
        "y2": { "$ref": "#/$defs/finiteNumber" }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "required": [
        "fill",
        "stroke",
        "strokeWidth",
        "opacity",
        "fontWeight",
        "fontStyle",
        "textAnchor"
      ],
      "properties": {
        "fill": {
          "type": "string",
          "pattern": "^(?:none|#[0-9a-f]{6})$"
        },
        "stroke": {
          "type": "string",
          "pattern": "^(?:none|#[0-9a-f]{6})$"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fontWeight": {
          "enum": [400, 700]
        },
        "fontStyle": {
          "enum": ["normal", "italic"]
        },
        "textAnchor": {
          "enum": ["start", "middle", "end"]
        }
      },
      "additionalProperties": false
    },
    "connector": {
      "type": "object",
      "required": ["fromId", "toId", "endpoints", "style"],
      "properties": {
        "fromId": { "$ref": "#/$defs/stableId" },
        "toId": { "$ref": "#/$defs/stableId" },
        "endpoints": { "$ref": "#/$defs/endpoints" },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    }
  }
}
