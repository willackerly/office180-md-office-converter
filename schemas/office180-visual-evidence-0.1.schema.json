{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office180.dev/schemas/office180-visual-evidence-0.1.schema.json",
  "title": "Office180 visual evidence 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_sha256", "subject", "capture"],
  "properties": {
    "schema": {
      "const": "office180-visual-evidence/0.1"
    },
    "evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "capture": {
      "$ref": "#/$defs/capture"
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "native_lifecycle": {
      "$ref": "#/$defs/nativeLifecycle"
    },
    "human_review": {
      "$ref": "#/$defs/humanReview"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*~).+$"
    },
    "status": {
      "enum": ["passed", "failed", "unavailable", "manual-required"]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "checkpoint", "artifact_path", "artifact_sha256"],
      "properties": {
        "lane": {
          "enum": ["markdown-docx", "pptv-pptx"]
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "artifact_path": {
          "$ref": "#/$defs/relativePath"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "executable_path"],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable_path": {
          "type": "string",
          "minLength": 1
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "os_version",
        "architecture",
        "locale",
        "display_scale"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "display_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rendering_flags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "style", "sha256"],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "captureInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "index", "pixel_size", "background"],
      "properties": {
        "unit": {
          "enum": ["page", "slide", "view"]
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "background": {
          "type": "string",
          "minLength": 1
        },
        "viewport_width_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "viewport_height_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "device_scale_factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "fit": {
          "const": "contain"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "timeout_seconds",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "captureOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "media_type",
        "width_px",
        "height_px",
        "colorspace",
        "page_count",
        "page_sha256"
      ],
      "properties": {
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_type": {
          "type": ["string", "null"]
        },
        "width_px": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "height_px": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "colorspace": {
          "type": ["string", "null"]
        },
        "page_count": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "page_sha256": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer_class",
        "status",
        "diagnostic",
        "renderer",
        "environment",
        "fonts",
        "input",
        "command",
        "output"
      ],
      "properties": {
        "renderer_class": {
          "enum": [
            "quick-look",
            "browser",
            "opendockit",
            "libreoffice",
            "pdf-rasterizer",
            "native-word",
            "native-powerpoint",
            "manual",
            "other"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "diagnostic": {
          "type": ["string", "null"]
        },
        "renderer": {
          "$ref": "#/$defs/renderer"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "fonts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/font"
          }
        },
        "input": {
          "$ref": "#/$defs/captureInput"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "output": {
          "$ref": "#/$defs/captureOutput"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostic": {
                "type": "null"
              },
              "output": {
                "properties": {
                  "path": {
                    "$ref": "#/$defs/relativePath"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "media_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "width_px": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height_px": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "colorspace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "page_sha256": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/sha256"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "diagnostic": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "renderer_class": {
                "const": "browser"
              },
              "status": {
                "const": "passed"
              }
            },
            "required": ["renderer_class", "status"]
          },
          "then": {
            "properties": {
              "input": {
                "required": [
                  "viewport_width_px",
                  "viewport_height_px",
                  "device_scale_factor",
                  "fit"
                ]
              },
              "environment": {
                "required": ["rendering_flags"]
              }
            }
          }
        }
      ]
    },
    "imageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_sha256", "image_path", "image_sha256"],
      "properties": {
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "image_path": {
          "$ref": "#/$defs/relativePath"
        },
        "image_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "comparisonImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "colorspace"],
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "colorspace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_pixels",
        "compared_pixels",
        "masked_pixels",
        "changed_pixels",
        "changed_fraction",
        "mean_absolute_error",
        "max_channel_delta"
      ],
      "properties": {
        "total_pixels": {
          "type": "integer",
          "minimum": 1
        },
        "compared_pixels": {
          "type": "integer",
          "minimum": 0
        },
        "masked_pixels": {
          "type": "integer",
          "minimum": 0
        },
        "changed_pixels": {
          "type": "integer",
          "minimum": 0
        },
        "changed_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_absolute_error": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "max_channel_delta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "antialias_tolerance",
        "max_changed_fraction",
        "max_mean_absolute_error",
        "max_channel_delta",
        "max_masked_fraction"
      ],
      "properties": {
        "antialias_tolerance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "max_changed_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_mean_absolute_error": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "max_channel_delta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "max_masked_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "masked_fraction", "white_means"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "masked_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "white_means": {
          "const": "ignored"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "diagnostic",
        "baseline",
        "candidate",
        "implementation",
        "dimensions",
        "metrics",
        "thresholds",
        "crop_regions",
        "mask",
        "changed_bounds"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "diagnostic": {
          "type": ["string", "null"]
        },
        "baseline": {
          "$ref": "#/$defs/imageReference"
        },
        "candidate": {
          "$ref": "#/$defs/imageReference"
        },
        "implementation": {
          "$ref": "#/$defs/comparisonImplementation"
        },
        "dimensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/dimensions"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/metrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "thresholds": {
          "$ref": "#/$defs/thresholds"
        },
        "crop_regions": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false
          }
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/mask"
            },
            {
              "type": "null"
            }
          ]
        },
        "changed_bounds": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "items": false
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_image_path": {
          "$ref": "#/$defs/relativePath"
        },
        "diff_image_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nativeLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer_class",
        "status",
        "application",
        "version",
        "method",
        "diagnostic"
      ],
      "properties": {
        "renderer_class": {
          "enum": ["native-word", "native-powerpoint"]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "application": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": ["automation", "manual"]
        },
        "diagnostic": {
          "type": ["string", "null"]
        },
        "open_without_repair": {
          "type": "boolean"
        },
        "editability_checked": {
          "type": "boolean"
        },
        "save_size": {
          "type": "integer",
          "minimum": 1
        },
        "save_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "zip_valid": {
          "type": "boolean"
        },
        "reopen_passed": {
          "type": "boolean"
        }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_sha256",
        "reviewer",
        "checkpoint",
        "crops",
        "decision",
        "rationale"
      ],
      "properties": {
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1
        },
        "crops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "enum": ["accept", "reject", "manual"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
