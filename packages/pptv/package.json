{
  "name": "@office180/pptv",
  "version": "0.1.0-alpha.2",
  "description": "Source-preserving PPTV scanner, editor foundation, text-fit preflight, strict PPTX canary, and CLI",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willackerly/office180-md-office-converter.git",
    "directory": "packages/pptv"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pptv": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "import": "./dist/ops/index.js"
    },
    "./assets/pptv-browser-0.1.script.html": "./assets/pptv-browser-0.1.script.html",
    "./schemas/manifest": "./dist/schemas/pptv-manifest-0.1.schema.json",
    "./schemas/patch": "./dist/schemas/pptv-patch-0.1.schema.json"
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/prepare-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-schemas.mjs",
    "prepack": "pnpm build",
    "pack:check": "npm pack --dry-run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fontkit": "2.0.4",
    "jsonc-parser": "^3.3.1",
    "jszip": "3.10.1",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9"
  }
}
