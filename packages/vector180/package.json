{
  "name": "@office180/vector180",
  "version": "0.1.0-alpha.5",
  "description": "Source-preserving Vector180 diagram/deck editor, hydrator, text-fit preflight, and mapped PPTX compiler/reconciler",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willackerly/office180-md-office-converter.git",
    "directory": "packages/vector180"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vector180": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "import": "./dist/ops/index.js"
    },
    "./assets/vector180-browser-0.1.script.html": "./assets/vector180-browser-0.1.script.html",
    "./assets/vector180-browser-kernel-0.1.iife.js": "./assets/vector180-browser-kernel-0.1.iife.js",
    "./schemas/manifest": "./dist/schemas/vector180-manifest-0.1.schema.json",
    "./schemas/atom-metadata": "./dist/schemas/vector180-atom-metadata-0.1.schema.json",
    "./schemas/patch": "./dist/schemas/vector180-patch-0.1.schema.json",
    "./schemas/migration-report": "./dist/schemas/vector180-migration-report-0.1.schema.json",
    "./schemas/source-diff": "./dist/schemas/vector180-source-diff-0.1.schema.json",
    "./schemas/reconciliation": "./dist/schemas/vector180-pptx-reconciliation-0.1.schema.json",
    "./schemas/reconcile-resolution-0.1": "./dist/schemas/vector180-reconcile-resolution-0.1.schema.json"
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "scripts": {
    "browser:build": "node scripts/build-browser-kernel.mjs && pnpm editor:build",
    "browser:check": "node scripts/build-browser-kernel.mjs --check && pnpm editor:check && pnpm browser-calibration:check",
    "browser-calibration:check": "node scripts/update-browser-calibration-evidence.mjs --check",
    "browser-calibration:update": "node scripts/update-browser-calibration-evidence.mjs",
    "build": "node scripts/prepare-dist.mjs && pnpm browser:check && tsc -p tsconfig.build.json && node scripts/copy-schemas.mjs",
    "editor:build": "node scripts/build-editor-app.mjs",
    "editor:check": "node scripts/build-editor-app.mjs --check",
    "prepack": "pnpm build",
    "pack:check": "npm pack --dry-run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.playwright.json",
    "test": "vitest run",
    "test:browser": "playwright test --project=chromium",
    "test:browser:all": "playwright test"
  },
  "dependencies": {
    "fontkit": "2.0.4",
    "jsonc-parser": "^3.3.1",
    "jszip": "3.10.1",
    "parse5": "^8.0.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9"
  }
}
