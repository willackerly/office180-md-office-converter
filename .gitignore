# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.venv/
*.egg-info/

# TypeScript / Node
node_modules/
dist/
coverage/
*.tsbuildinfo
packages/pptv/playwright-report/
packages/pptv/test-results/
packages/vector180/playwright-report/
packages/vector180/test-results/
*.editable.pptv.html
*.editable.vector180.html
*.composed.vector180.html
*.editable.html
.office180-native-work/

# OS cruft
.DS_Store

# Test artifacts — generated DOCX files from running the converters
*.docx
!tests/fixtures/**/*.docx
!manual-tests/office-native-roundtrip/baselines/*.docx

# Native Office challenge work products. The reproducible, PII-free authority
# lives under baselines/; files beside the sources are human edit/save outputs.
manual-tests/office-native-roundtrip/*.pptx
manual-tests/office-native-roundtrip/*.pptv.map.json
manual-tests/office-native-roundtrip/*.vector180.map.json
manual-tests/office-native-roundtrip/*.reconcile-resolution.json
manual-tests/office-native-roundtrip/*.composed.pptv.html
manual-tests/office-native-roundtrip/*.composed.vector180.html
manual-tests/office-native-roundtrip/~$*
manual-tests/office-native-roundtrip/native-work-test/
manual-tests/office-native-roundtrip/previews/
manual-tests/office-native-roundtrip/regenerate-*/
manual-tests/office-native-roundtrip/runs/

# Editors
.vscode/
.idea/
*.swp

# Agent worktrees / local tooling state (never scanned by enforcement scripts)
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/skills/**
.claude/worktrees/

# Rebar-generated Steward state
architecture/.state/*.json
architecture/.state/steward-report.md
!architecture/.state/.gitkeep
