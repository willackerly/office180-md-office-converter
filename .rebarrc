# Rebar configuration for office180-md-office-converter
#
# Tier controls which checks are enforced:
#   1 = Partial  — contract refs + TODOs only (solo dev / early adoption)
#   2 = Adopted  — + headers, freshness, registry (small team)
#   3 = Enforced — + ground truth, compliance (department / production)
#
# This solo-maintained dual-language converter ships persistent source
# contracts, so the full adopter-side Tier 3 surface is enabled: cold-start
# checks, contract/doc gates, generated registry, Steward, ground truth,
# package checks, and CI.

tier = 3
# Legacy alias retained for older rebar scripts.
REBAR_TIER=3

# Version compatibility
REBAR_VERSION=3.0.0-beta

# Optional: Override specific check behaviors
# REBAR_SKIP_CHECKS="check-freshness"
# REBAR_TODO_STRICT=true
# REBAR_CONTRACT_STRICT=false

# The adopter-local ci-check intentionally omits rebar's source-repository-only
# bootstrap-template drift gate; there is no templates/project-bootstrap tree
# in this repository.
